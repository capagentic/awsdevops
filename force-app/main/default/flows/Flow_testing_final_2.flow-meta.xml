<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Record-Triggered (After Save) Flow on Opportunity. Fires when StageName changes. Evaluates stage change and performs actions for Closed Won, Closed Lost, and High Value deals.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_StageNameChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.StageName})</expression>
    </formulas>
    <interviewLabel>Flow_testing_final_2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow_testing_final_2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Evaluate_Stage_Change</name>
        <label>Evaluate Stage Change</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>Closed_Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateCloseDate</targetReference>
            </connector>
            <label>Closed Won</label>
        </rules>
        <rules>
            <name>Closed_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateLossTask</targetReference>
            </connector>
            <label>Closed Lost</label>
        </rules>
        <rules>
            <name>High_Value_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateManagerNotificationTask</targetReference>
            </connector>
            <label>High Value Deal</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>UpdateCloseDate</name>
        <label>UpdateCloseDate</label>
        <locationX>50</locationX>
        <locationY>254</locationY>
        <connector>
            <targetReference>CreateThankYouTask</targetReference>
        </connector>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordCreates>
        <name>CreateThankYouTask</name>
        <label>CreateThankYouTask</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Send Thank You Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>CreateLossTask</name>
        <label>CreateLossTask</label>
        <locationX>314</locationX>
        <locationY>254</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Capture Loss Reason</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>CreateManagerNotificationTask</name>
        <label>CreateManagerNotificationTask</label>
        <locationX>578</locationX>
        <locationY>254</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Notify Sales Manager - High Value Deal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Stage_Change</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.StageName})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
